# Archie Bridge configuration.
#
# Copy to bridge/.env and fill in. bridge/.env is gitignored and must never be
# committed. The token is a credential: anyone holding it controls the bot.

# ── Required ────────────────────────────────────────────────────────────────

# From @BotFather (/newbot, or /token for an existing bot).
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample

# ── The two channels ────────────────────────────────────────────────────────
#
# EVERYTHING from a chat id in neither list is ignored and logged, with no reply.
# Both empty means "trust nobody" — the bridge refuses to start rather than run
# open. An id in BOTH lists is a configuration error and the bridge refuses to
# start, because the channel would then depend on lookup order.
#
# Discover an id by adding the bot to the chat and sending /start; it replies
# with the id and which channel it is on.

# PUBLIC — untrusted user reports relayed by Archie. Full pipeline:
# triage → GATE 1 (a human approves the plan) → implement → gates → GATE 2.
# (ALLOWED_CHAT_IDS is still read as the legacy name for this list.)
PUBLIC_CHAT_ID=-1001234567890

# FOUNDER — messages here are authorised work requests, so GATE 1 is skipped and
# triage flows straight into implementation. Everything else is unchanged: the
# report is still fenced as untrusted data, the session still has no git tools,
# a suspicious classification is still terminal, and GATE 2 still stands between
# the branch and main. Leave empty if you do not want a founder channel.
FOUNDER_CHAT_ID=-1009876543210

# Where plans and results are posted. Defaults to the first founder id, then the
# first public id.
NOTIFY_CHAT_ID=-1009876543210

# ── Safety limits ───────────────────────────────────────────────────────────

# Max NEW tasks accepted per rolling hour. A spam flood past this is dropped
# before any Claude session is spawned, so it cannot burn tokens.
MAX_TASKS_PER_HOUR=10

# Long-poll window handed to getUpdates.
POLL_TIMEOUT_SEC=30

# Session ceilings. A runaway session is killed at these limits.
TRIAGE_TIMEOUT_SEC=300
IMPL_TIMEOUT_SEC=1800
TRIAGE_MAX_TURNS=30
IMPL_MAX_TURNS=80

# Per-gate timeout (tsc / build / eslint / e2e each get this long).
GATE_TIMEOUT_SEC=1800

# ── Email hand-off to the CTO ───────────────────────────────────────────────
#
# Sent automatically once a branch is pushed with green gates, and also when a
# session concludes the change should NOT ship. A negative recommendation is
# never suppressed. Suspicious and rejected tasks never email.
#
# If SMTP fails the bridge retries (SMTP_RETRIES), then posts the full email
# text into the chat and marks the task email_failed, so a decision is never
# lost to a mail outage.

CTO_EMAIL=cto@example.com
FOUNDER_EMAIL=founder@example.com
SMTP_FROM=archie-bridge@example.com

# Where to get these: any transactional SMTP provider. Two that work with the
# defaults below —
#   Resend    smtp.resend.com : 587,  user "resend",  pass = an API key from
#             https://resend.com/api-keys
#   Postmark  smtp.postmarkapp.com : 587, user = pass = a Server API token from
#             the server's API Tokens tab
# Gmail also works with an App Password (not your account password), but a
# transactional provider is the better choice for machine-sent mail.
#
# SMTP_PASS is a credential. It is redacted from every log line, and this file's
# real counterpart (bridge/.env) is gitignored.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=replace-me
# true → implicit TLS (port 465). false → plain connect then STARTTLS (port 587).
SMTP_SECURE=false
# Retries after the first attempt fails. 2 = three attempts total.
SMTP_RETRIES=2

# ── Optional overrides ──────────────────────────────────────────────────────

# MAIN_BRANCH=main
# CLAUDE_BIN=claude
# GATE_TSC=./node_modules/.bin/tsc --noEmit -p tsconfig.json
# GATE_BUILD=./node_modules/.bin/next build
# GATE_ESLINT=./node_modules/.bin/eslint src/
# GATE_E2E=./node_modules/.bin/playwright test

# Set to 1 to process updates that queued while the bridge was offline. Default
# (unset) fast-forwards past them: a button press from an hour ago is not
# consent to act now. Nothing is lost — press again against the live bridge.
ARCHIE_DRAIN_BACKLOG=0
