node_modules/
.next/
tsconfig.tsbuildinfo
# Local wrangler / miniflare emulator state from `wrangler r2 ...`
# without --remote (gets created automatically by the v4 CLI even on
# upload calls). Never commit — leaks the entire local PMTiles blob.
.wrangler/
# data/layers/ is the source of truth for map overlays — must ship to
# Vercel via git, otherwise every /api/layers/* route 500s with ENOENT.
# Reference PDFs in data/meydan/ are not needed at runtime, stay ignored.
data/meydan/
# Raw plot-level GeoJSON is too large for git (438MB). Kept on disk for
# PMTiles generation only. Production serves the built .pmtiles via
# Cloudflare R2 (NEXT_PUBLIC_TILES_BASE_URL on Vercel) — see
# docs/r2-migration-plan.md. The .pmtiles files themselves are
# gitignored below; only the rebuild + upload scripts are tracked.
data/layers/dda-plots/
data/layers/ad-plots/
data/layers/oman-plots/
# PMTiles assets moved to Cloudflare R2 on 2026-05-24 (a z18 rebuild
# at 384MB total exceeded GitHub's 100MB per-file hard limit). To
# rebuild + republish: scripts/rebuild-tiles-z18.sh + scripts/upload-tiles-r2.sh.
public/tiles/*.pmtiles
# Inset (negative-buffer) copy of the per-community plot GeoJSONs,
# regenerated each pipeline run by scripts/inset-geojson.py. Same
# rationale as data/layers/*-plots/ — too large for git, only used
# to feed prepare-tiles.ts.
data/layers-inset/
# Intermediate newline-delimited GeoJSON used to build PMTiles
data/tiles/
# Raw KMZ/KML source material + instruction screenshots from founder.
# Reference-only; individual layers are ingested into data/layers/.
data/master-plans/kadastr/
.env
.env.local
.env.*.local
# Backup / rotation copies — e.g. .env.local.backup-2026-04-28-rotation.
# `.env*` below already covers these; the explicit line documents intent
# and keeps `grep .env.local` in this file useful.
.env.local.*
*.log
dist/
__pycache__/
.vercel
.env*

