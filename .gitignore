node_modules/
.next/
tsconfig.tsbuildinfo
# data/layers/ is the source of truth for map overlays — must ship to
# Vercel via git, otherwise every /api/layers/* route 500s with ENOENT.
# Reference PDFs in data/meydan/ are not needed at runtime, stay ignored.
data/meydan/
# Raw plot-level GeoJSON is too large for git (438MB). Kept on disk for
# PMTiles generation only. Production serves pre-built .pmtiles from public/tiles/.
data/layers/dda-plots/
data/layers/ad-plots/
data/layers/oman-plots/
# Intermediate newline-delimited GeoJSON used to build PMTiles
data/tiles/
# Raw KMZ/KML source material + instruction screenshots from founder.
# Reference-only; individual layers are ingested into data/layers/.
data/master-plans/kadastr/
# Land Advertisement Monitor runtime cache (Spec 09 descoped MVP).
# Contains extracted social-post data — never commit. An example shape
# file (data/land-monitor/cache.json.example) IS committed for reference.
data/land-monitor/cache.json
# Mole Agent (§41) raw subsurface downloads — large InSAR rasters (Sentinel-1
# SLC products are GB-scale), USGS shapefiles, etc. Kept on disk for
# processing only; processed GeoJSONs in data/processed/mole/ ARE committed.
# README at data/raw/mole/README.md documents what's intended to live here.
data/raw/mole/*
!data/raw/mole/README.md
!data/raw/mole/.gitkeep
.env
.env.local
.env.*.local
*.log
dist/
__pycache__/
