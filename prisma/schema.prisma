// ZAAHI — Prisma schema
// Source of truth for User / Parcel / Deal / Document.
// Money: BigInt fils (1 AED = 100 fils). Geometry: GeoJSON polygon as Json.
// User.id == Supabase auth.users.id (no passwordHash here).
// Area is stored in sqft (Dubai market standard).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── ENUMS ─────────────────────────────────────────────

enum UserRole {
  // Cohort v1.0 official roles (10) + PROJECT_MANAGER added 2026-05-23:
  OWNER
  BROKER
  PROJECT_MANAGER
  DEVELOPER
  BUYER
  ARCHITECT
  POA
  INTERMEDIARY
  RELATIVE
  REFERRAL
  OTHER
  ADMIN // Жан + Dymo only — system role on User.role for queue access.
  // NEVER on RegistrationApplication.roleApplied.

  // Deprecated (pre-cohort, kept for existing rows):
  INVESTOR // pre-cohort; auto-migrate to BUYER on next user touch
}

enum ParcelStatus {
  VACANT
  PENDING_REVIEW
  VERIFIED
  REJECTED
  LISTED
  IN_DEAL
  SOLD
  DISPUTED
  FROZEN
  // Private parcel visible only to ownerId + active VaultShare
  // recipients. Phase 1 of vault refactor (founder spec 2026-05-30) —
  // unifies vault entries onto the Parcel + AffectionPlan source of
  // truth so vault and public listings render through the same code.
  VAULT_PRIVATE
}

// Mirrors states in backend/services/deal_engine.ts
enum DealStatus {
  INITIAL
  DEAL_INITIATED
  DEPOSIT_SUBMITTED
  AGREEMENT_SIGNED
  DOCUMENTS_COLLECTED
  GOVERNMENT_VERIFIED
  NOC_REQUESTED
  TRANSFER_FEE_PAID
  DLD_SUBMITTED
  DEAL_COMPLETED
  DISPUTE_INITIATED
  DEAL_CANCELLED
}

enum DocumentType {
  TITLE_DEED
  PASSPORT
  EMIRATES_ID
  NOC
  SPA // Sale & Purchase Agreement
  OQOOD
  EJARI
  POWER_OF_ATTORNEY
  VALUATION_REPORT
  OTHER
}

// Ambassador program commission statuses.
// PENDING  — commission accrued on deal COMPLETE, awaiting payout.
// PAID     — admin marked as paid out (bank/ZAH token/etc).
// REVERSED — deal later cancelled/disputed, commission clawed back.
enum CommissionStatus {
  PENDING
  PAID
  REVERSED
}

// Digital-twin building layers on /parcels/map. Independent of the LISTED
// Parcel pipeline — Parcel = tradable land; Building = contextual 3D of
// completed / under-construction / planned towers for map context and
// SEO. Driven by scraped data (propsearch.ae · bayut · OSM) + artist GLB.
enum BuildingStatus {
  COMPLETED
  UNDER_CONSTRUCTION
  PLANNED
}

// ── MODELS ────────────────────────────────────────────

model User {
  id        String   @id // matches Supabase auth.users.id
  email     String   @unique
  role      UserRole
  name      String
  // public-facing handle. Source-of-truth = Step 1 of /register form
  // (per spec-05 §5.2 / GAP-2 = Option A). Defensive fallback in
  // /api/users/sync derives it from email for legacy/autoMigrated users.
  // Real name (above) stays admin-visible only — never expose nickname
  // and name in the same public response.
  nickname  String?  @unique
  phone     String?
  createdAt DateTime @default(now())

  // ── Ambassador program ──
  // referralCode: unique 8-char code (generated on ambassador activation)
  // referredById: L1 upline (the user who invited this one). Immutable after set.
  // referredAt:   when the referral cookie was consumed at signup.
  // ambassadorActive: has this user activated ambassador mode (gets commissions)?
  referralCode     String?   @unique
  referredById     String?
  referredAt       DateTime?
  ambassadorActive Boolean   @default(false)

  // ── Profile fields (added 2026-04-16 with dashboards Phase 1) ──
  // All nullable/additive; safe to deploy with existing rows. The
  // /dashboard profile form hydrates from these and persists via
  // PATCH /api/me.
  avatarUrl           String?
  bio                 String?
  timezone            String? // IANA, e.g. "Asia/Dubai"
  language            String? // "EN" | "AR" | "RU" | "UK" | "SQ" | "FR"
  currency            String? // "AED" | "USD" | "EUR"
  companyName         String?
  reraLicense         String? // BROKER only
  brnNumber           String? // BROKER only
  lastSeenAt          DateTime?
  notificationPrefs   Json? // { inApp: {...}, email: {...}, push: {...} }
  onboardingCompleted Boolean   @default(false)

  parcels       Parcel[]      @relation("ParcelOwner")
  dealsAsSeller Deal[]        @relation("DealSeller")
  dealsAsBuyer  Deal[]        @relation("DealBuyer")
  dealsAsBroker Deal[]        @relation("DealBroker")
  dealMessages  DealMessage[]

  referredBy  User?        @relation("UserReferrals", fields: [referredById], references: [id])
  referrals   User[]       @relation("UserReferrals")
  commissions Commission[]

  // Phase 1 user-dashboard relations
  savedParcels  SavedParcel[]
  parcelViews   ParcelView[]
  notifications Notification[]
  activityLog   ActivityLog[]
  savedSearches SavedSearch[]

  // Cohort Pilot v1 relations
  registrationApplication RegistrationApplication?
  plotClaims              PlotClaim[]

  // Private Plot Vault v2.1 relations (spec: docs/specs/phase-2/private-plot-vault)
  vaultEntriesOwned     VaultEntry[]    @relation("VaultEntryOwner")
  vaultEntriesAddedBy   VaultEntry[]    @relation("VaultEntryAddedBy")
  vaultSharesReceived   VaultShare[]    @relation("VaultShareRecipient")
  vaultActivityAuthored VaultActivity[] @relation("VaultActivityActor")

  @@index([role])
  @@index([referredById])
}

model Parcel {
  id               String       @id @default(cuid())
  plotNumber       String
  ownerId          String
  owner            User         @relation("ParcelOwner", fields: [ownerId], references: [id])
  area             Float // sqft (Dubai market standard)
  emirate          String
  district         String
  latitude         Float?
  longitude        Float?
  geometry         Json? // GeoJSON polygon
  status           ParcelStatus @default(VACANT)
  currentValuation BigInt? // fils
  isTokenized      Boolean      @default(false)
  openToJV         Boolean      @default(false) // Joint-Venture signal — owner is open to JV partnership terms instead of (or alongside) a cash sale.
  jvDetails        String? // Optional JSON-encoded JV term sheet (jvType, gfaSharing, landownerShare, developerShare, commissionPct, …). Renders as the "JV Terms" section in SidePanel when openToJV=true.

  // Cohort Pilot v1 verification (spec-05 §5.5).
  // verifiedOwnerUserId is set when an OWNER PlotClaim transitions to
  // VERIFIED. Diverges from ownerId (creator) per LOCK-8 / CORR-1.
  // Single-verified-owner invariant enforced in API logic, not DB.
  verifiedOwnerUserId String?
  verifiedAt          DateTime?
  verifiedById        String? // admin who verified

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals          Deal[]
  documents      Document[]
  affectionPlans AffectionPlan[]

  // Phase 1 user-dashboard relations
  savedBy SavedParcel[]
  views   ParcelView[]

  // Cohort Pilot v1 relations
  claims PlotClaim[]

  // Private Plot Vault v2.1 — entries that reference this public parcel
  vaultEntryLinks VaultEntry[] @relation("VaultEntryPublicParcel")

  @@unique([emirate, district, plotNumber])
  @@index([ownerId])
  @@index([emirate])
  @@index([district])
  @@index([status])
}

model Deal {
  id       String     @id @default(cuid())
  parcelId String
  parcel   Parcel     @relation(fields: [parcelId], references: [id])
  sellerId String
  seller   User       @relation("DealSeller", fields: [sellerId], references: [id])
  buyerId  String
  buyer    User       @relation("DealBuyer", fields: [buyerId], references: [id])
  brokerId String?
  broker   User?      @relation("DealBroker", fields: [brokerId], references: [id])
  status   DealStatus @default(INITIAL)

  // priceInFils kept for backward compatibility — mirrors offerPriceInFils on create.
  priceInFils       BigInt
  offerPriceInFils  BigInt?
  agreedPriceInFils BigInt?

  paymentType    String? // CASH | MORTGAGE | INSTALLMENT
  mortgageBank   String?
  mortgageAmount BigInt?
  closingDays    Int     @default(90)
  conditions     String?
  initialMessage String?

  depositPaid  Boolean @default(false)
  mouSigned    Boolean @default(false)
  nocReceived  Boolean @default(false)
  dldApproved  Boolean @default(false)
  dldReference String?

  rating Int? // 1..5, set on completion

  // Platform fee (0.25% of agreedPriceInFils) — computed and frozen at DEAL_COMPLETED.
  // Basis for ambassador commission distribution. Null until deal completes.
  platformFeeFils BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents   Document[]
  messages    DealMessage[]
  auditEvents DealAuditEvent[]
  commissions Commission[]

  @@index([parcelId])
  @@index([sellerId])
  @@index([buyerId])
  @@index([brokerId])
  @@index([status])
}

model DealMessage {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  fileUrl   String?
  createdAt DateTime @default(now())

  @@index([dealId])
  @@index([createdAt])
}

model DealAuditEvent {
  id           String   @id @default(cuid())
  dealId       String
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  eventType    String // OFFER_SUBMITTED | OFFER_ACCEPTED | COUNTER_OFFER | DEPOSIT_PAID | MOU_SIGNED | NOC_REQUESTED | NOC_RECEIVED | DLD_SUBMITTED | DLD_APPROVED | COMPLETED | CANCELLED | DISPUTED
  txHash       String? // polygon tx hash, or "pending"
  documentHash String? // SHA-256 of related document, if any
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([dealId])
  @@index([txHash])
  @@index([eventType])
}

model AffectionPlan {
  id        String   @id @default(cuid())
  parcelId  String
  parcel    Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  fetchedAt DateTime @default(now())
  source    String // e.g. "gis.dda.gov.ae/DIS"

  plotNumber      String
  oldNumber       String?
  projectName     String?
  community       String?
  masterDeveloper String?

  plotAreaSqm  Float?
  plotAreaSqft Float?
  maxGfaSqm    Float?
  maxGfaSqft   Float?

  maxHeightCode   String? // raw, e.g. "G+15"
  maxFloors       Int?
  maxHeightMeters Float?
  far             Float?

  setbacks       Json? // [{side, building, podium}, ...]
  landUseMix     Json? // [{category, sub, areaSqm}, ...]
  sitePlanIssue  DateTime?
  sitePlanExpiry DateTime?
  notes          String?

  buildingLimitGeometry Json? // GeoJSON Polygon from MAIN_MAP layer 8
  raw                   Json? // full parsed bundle for debugging

  // Optional Salesforce URL for the "Plot Guidelines" PDF that DDA's
  // plot info page surfaces alongside the existing "Plot Details PDF".
  // Format: https://dcca.my.salesforce-sites.com/services/apexrest/GIS?GetPlotSitePlan=<id>
  // Null when DDA didn't expose the link for this plot. Set by
  // scripts/seed-dda + the backfill script. Public URL — no DDA auth.
  plotGuidelinesUrl String?

  // 3D rendering style for this plot. Null or "SIGNATURE" = default ZAAHI
  // tiering (podium/body/crown based on floors). "FLAT" = single block
  // of full footprint at full height — correct for most commercial office
  // buildings that have no visual podium/tower distinction. Data-driven:
  // any parcel can opt in/out per AffectionPlan row; no hardcoded per-plot
  // logic in the renderer.
  buildingStyle String?

  @@index([parcelId])
  @@index([fetchedAt])
}

model Document {
  id         String       @id @default(cuid())
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id])
  parcelId   String?
  parcel     Parcel?      @relation(fields: [parcelId], references: [id])
  type       DocumentType
  fileUrl    String
  uploadedAt DateTime     @default(now())

  @@index([dealId])
  @@index([parcelId])
  @@index([type])
}

// Immutable, append-only ledger of ambassador commission accruals.
// Never update or delete rows — use status=REVERSED to claw back.
// Computed in awardCommissions() on deal COMPLETE.
model Commission {
  id           String           @id @default(cuid())
  dealId       String
  deal         Deal             @relation(fields: [dealId], references: [id])
  ambassadorId String
  ambassador   User             @relation(fields: [ambassadorId], references: [id])
  level        Int // 1, 2, or 3
  sourceUserId String // the direct referral whose deal triggered this commission
  amountFils   BigInt // commission amount in fils
  basisFils    BigInt // platform fee amount this commission was calculated from
  rate         Decimal          @db.Decimal(5, 4) // 0.3000 / 0.1500 / 0.0500
  status       CommissionStatus @default(PENDING)
  payoutMethod String? // "bank" | "zah_token" | null
  payoutRef    String? // bank transfer ref, tx hash, etc.
  createdAt    DateTime         @default(now())
  paidAt       DateTime?

  // Defense-in-depth against race conditions: a given
  // (deal, ambassador, level, sourceUser) tuple can only exist once.
  // Prevents duplicate commission accrual even if optimistic concurrency
  // control in the caller fails.
  @@unique([dealId, ambassadorId, level, sourceUserId])
  @@index([ambassadorId, status])
  @@index([dealId])
  @@index([level])
  @@index([status])
}

// Ambassador registration applications from the public /join page.
// Paid-tier model (SILVER / GOLD / PLATINUM) — one-time USDT TRC-20 purchase
// for lifetime membership. Commissions live on the Commission table once the
// application is verified and the ambassador user is activated. Rows are
// PENDING until admin verifies the USDT tx, then VERIFIED (ambassador enabled)
// or REJECTED (payment not found / fraud).
model AmbassadorApplication {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String
  company         String?
  experience      String?
  plan            String // SILVER | GOLD | PLATINUM
  txHash          String
  status          String    @default("PENDING") // PENDING | VERIFIED | ACTIVE | REJECTED
  checklistData   Json? // 10 onboarding checkboxes — all must be true at submit
  // ── Admin review (added 2026-04-15 with admin panel) ──
  // All fields are nullable — populated only when admin acts on the application.
  referralCode    String?   @unique // assigned on approval, merged to User.referralCode at sync
  rejectionReason String?
  approvedAt      DateTime?
  approvedBy      String? // admin user id (supabase sub) or email
  rejectedAt      DateTime?
  rejectedBy      String?
  linkedUserId    String? // populated when the approved applicant eventually signs up
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}

// Analytics-only: records landing page hits on /r/[code].
// Lightweight — no PII, ip is hashed. Safe to prune after 90 days.
model ReferralClick {
  id                String   @id @default(cuid())
  referralCode      String
  ipHash            String? // SHA256(ip+salt) — for dedup, not re-identification
  userAgent         String?
  convertedToUserId String? // filled when a signup is attributed to this click
  createdAt         DateTime @default(now())

  @@index([referralCode])
  @@index([createdAt])
}

// ── Phase 1 user-dashboard models ───────────────────────────────────
// All added 2026-04-16 with USER_DASHBOARDS_RESEARCH.md Phase 1. Additive,
// never modified after create (immutable audit trail for ParcelView /
// ActivityLog / Notification; SavedParcel and SavedSearch rows get
// CRUD'd normally).

// BUYER / OWNER / anyone can save a parcel from the map or detail page.
// @@unique([userId, parcelId]) — saving twice is a no-op upsert.
model SavedParcel {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parcelId  String
  parcel    Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, parcelId])
  @@index([userId])
  @@index([parcelId])
}

// Append-only view log. Drives OWNER "who viewed my plot" analytics
// (aggregate only — no PII exposed to owner). Debounced on the client
// so refreshing a page doesn't inflate counts.
//   userId nullable — anonymous viewers logged with ipHash only.
//   Retention: prune rows > 180 days in a scheduled job (Phase 6+).
model ParcelView {
  id        String   @id @default(cuid())
  parcelId  String
  parcel    Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipHash    String? // SHA256(ip+salt)
  userAgent String?
  viewedAt  DateTime @default(now())

  @@index([parcelId, viewedAt])
  @@index([userId, viewedAt])
}

// In-app notification inbox. `kind` is a machine-readable event type
// (e.g. "PLOT_VIEW_SPIKE", "NEW_OFFER", "SAVED_SEARCH_MATCH"); payload
// is JSON with contextual IDs the UI uses to render links. Email/push
// delivery is a separate pipeline (Phase 6) — this table is the
// source-of-truth inbox.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // uppercase snake_case
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Lightweight user event stream — drives "Recent Activity" in dashboard.
// `kind` parallels Notification.kind. `ref` is an optional link target
// (e.g. parcelId or dealId). Payload is JSON for renderer context.
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  ref       String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// BUYER saved filter + optional bounding box. Triggers alerts when a
// new plot matches (Phase 6 — alert delivery). Max 10 per user enforced
// in API layer, not DB.
//   filters: arbitrary JSON, validated by Zod server-side
//   lastNotifiedAt: last time we emailed/pushed a match
model SavedSearch {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  filters        Json
  locationBounds Json? // { minLng, minLat, maxLng, maxLat }
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

// Contextual 3D buildings on /parcels/map — the "digital twin" layer.
// Separate from Parcel (tradable land). A Building is a real physical
// tower (completed or under construction) sourced from propsearch.ae /
// OSM / developer sites, optionally paired with an artist-supplied
// glTF for photo-realistic rendering or a procedural placeholder.
//
// Append-only by convention. When a new source is scraped, add a new
// row rather than updating fields in place — provenance matters.
//
// linkedParcelId is nullable: a Building may (later) be linked to a
// LISTED Parcel if DDA attribution lands on the same plot. No FK —
// this is a loose reference so the Building table is independent of
// Parcel lifecycle.
model Building {
  id String @id @default(cuid())

  // ── Identity ──
  name   String
  status BuildingStatus

  // ── Location ──
  community        String
  masterPlan       String?
  plotNumber       String? // nullable — may not be in DDA yet
  emirate          String  @default("Dubai")
  centroidLat      Float
  centroidLng      Float
  footprintPolygon Json? // GeoJSON Polygon from OSM if available

  // ── Construction ──
  developer           String?
  architect           String?
  completionYear      Int? // COMPLETED
  expectedCompletion  Int? // UNDER_CONSTRUCTION / PLANNED
  constructionStarted Int?

  // ── Specs ──
  floors       Int?
  heightM      Float?
  totalUnits   Int?
  buildingType String? // "residential" | "commercial" | "mixed_use" | "hotel" | ...

  // ── Rich content (card) ──
  description String? @db.Text
  amenities   Json? // ["Pool", "Gym", ...]
  photos      Json? // [{ url, credit?, alt? }, ...]

  // ── 3D ──
  modelPath     String? // e.g. "models/candidate-sample.glb" (served under /public)
  rotationDeg   Float   @default(0)
  scaleFactor   Float   @default(1) // 0.01 for cm-sourced models
  modelProvider String? // artist name, or "procedural"

  // ── Provenance ──
  propsearchUrl   String?
  sources         Json? // [{ label, url, fetchedAt }, ...]
  confidenceLevel String  @default("medium") // "high" | "medium" | "low"

  // ── Workflow ──
  workflowStatus String   @default("draft") // "draft" | "pending_review" | "live" | "archived"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Future linkage when DDA sync finds a matching Parcel row.
  linkedParcelId String?

  @@index([community])
  @@index([status])
  @@index([workflowStatus])
}

// ── Cohort Pilot v1 (spec-05 §5.3 / §5.4) ─────────────

// Public registration applications submitted via /register (Step 6).
// status starts at PENDING_REVIEW (or WAITLIST when role cap reached);
// an admin transitions to APPROVED or REJECTED in /admin/queue. The
// application's nickname is propagated to User.nickname on approval.
//
// autoMigrated=true rows are seeded for pre-cohort admin accounts
// (system user; Жан + Dymo seed via the §5.2 defensive fallback in
// /api/users/sync). Excluded from per-role cap counting.
model RegistrationApplication {
  id     String  @id @default(cuid())
  // FK to User. The User row is created in Supabase Auth at signup
  // with user_metadata.approved=false. Prisma User row gets created
  // when /api/users/sync runs (post-login). Until then userId is NULL.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  email         String    @unique
  nickname      String // unique-checked at submit (against User + this table)
  // NULL only when autoMigrated=true. Cohort applicants must specify
  // one of the 10 cohort roles; ADMIN is NEVER valid here (system role).
  roleApplied   UserRole?
  // KYC docs uploaded to Supabase Storage `registration-docs` bucket.
  // Format: array of { kind, signedUrl, originalName, sizeBytes,
  //                    contentType, uploadedAt }
  documentsJson Json
  // Only populated when roleApplied = REFERRAL.
  // Shape: { directContact: boolean, intermediariesCount: 0 | 1 | 2 | 3 }
  // intermediariesCount: 3 = "3 or more"
  referralPath  Json?

  status          RegistrationStatus @default(PENDING_REVIEW)
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?

  autoMigrated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleApplied, status]) // for cap counter queries
  @@index([status, createdAt]) // for admin queue list ordering
  @@index([email])
}

enum RegistrationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  WAITLIST
}

// Per-parcel claim by a user. A Parcel can have multiple claims at
// different roles (e.g. one OWNER, one BROKER, one INTERMEDIARY).
// Verifiable roles (OWNER/BROKER/DEVELOPER/ARCHITECT/POA) start at
// PENDING and require admin approval; non-verifiable roles
// (BUYER/INTERMEDIARY/RELATIVE/REFERRAL/OTHER) start at SELF_DECLARED.
//
// roleAtClaim differs from User.role / RegistrationApplication.roleApplied:
// e.g. a registered BROKER may join a plot as a RELATIVE.
//
// Backfill on migration: every existing Parcel gets one
// roleAtClaim='ADMIN' status='VERIFIED' claim from its creator (the
// system user) so cohort UI surfaces have a consistent claims history.
model PlotClaim {
  id            String      @id @default(cuid())
  parcelId      String
  parcel        Parcel      @relation(fields: [parcelId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  roleAtClaim   UserRole
  priceAed      BigInt // user's stated price for this plot — fils (despite the name)
  status        ClaimStatus
  documentsJson Json?

  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Spec §8.4 step 3 invariant — one user = one claim per plot. Audit
  // (docs/audits/add-plot-cohort-audit.md Q4) flagged the missing DB-level
  // guard; Step 9 ships the constraint alongside POST /api/parcels/[id]/claim
  // so simultaneous double-submits surface as a clean 409 instead of two
  // racing rows. The 118 backfilled rows are unique by construction
  // (one per parcel × the system user).
  @@unique([parcelId, userId])
  @@index([parcelId])
  @@index([userId])
  @@index([status])
  @@index([parcelId, roleAtClaim, status]) // CORR-5: TitleDeedVerification tab filter
}

enum ClaimStatus {
  PENDING // verifiable role awaiting admin review
  VERIFIED // verifiable role admin-approved
  SELF_DECLARED // non-verifiable role; ALWAYS displayed with a note
  REJECTED // admin rejected with reason
}

// ── PRIVATE PLOT VAULT — Phase 2.1 MVP ─────────────────────────────
// Spec: docs/specs/phase-2/private-plot-vault/
// Vault is the personal plot tracker. Not a legal pipeline — public
// listings (with their Title-Deed/Contract verification) live in the
// existing /api/parcels/submit flow. Vault crosses into Listings only
// via Promote-to-Public, which routes through that same submit form.
//
// Multiple users can independently track the same plot; their entries
// live as separate rows (unique by (ownerId, emirate, district,
// plotNumber)). Cross-user awareness surfaces via the conflictsWith-
// Others flag (info-only banner; DISPUTED status + admin arbitration
// are Phase 2.2 features gated on cohort signal).

enum VaultStage {
  LEAD // just added; haven't engaged owner yet
  CONTACTED // spoken with owner, no commitment
  NEGOTIATING // back-and-forth on price/terms
  AGREEMENT_SIGNED // NDA / authorisation to market
  PROMOTED // moved to Public Listings (kept here for history)
  LOST // abandoned, owner went elsewhere
  CLOSED // converted to Deal (kept for history)
}

enum VaultSharePermission {
  VIEW
  FEASIBILITY // declared now; Phase 2.2 ships gate behaviour
  OFFER // declared now; Phase 2.2 ships gate behaviour
}

// Broker / developer / owner's private pipeline entry for a single plot.
// Plot identity refers to a real plot in the world, not necessarily a
// Parcel row — most entries describe plots that have no public listing.
//
// `publicParcelId` is set when the underlying plot is ALSO publicly
// listed (including via this user's own Promote-to-Public). Linking is
// informational; the public listing has independent lifecycle.
//
// `ownerContact` carries PII. MVP stores unencrypted; Phase 2.2 will
// encrypt at rest. Always served via the vault routes which gate on
// ownerId / active share.
//
// `@@unique([ownerId, emirate, district, plotNumber])` — one user, one
// entry per plot. Multiple users CAN each have their own entry for the
// same plot (the deliberate design behind the separate-table model —
// see decisions.md D1).
model VaultEntry {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("VaultEntryOwner", fields: [ownerId], references: [id])

  // Attribution. addedByUserId == ownerId for direct uploads; differs
  // when the entry was created via "Add to my vault" on a shared entry.
  // provenanceChain preserves the trail across imports.
  addedByUserId       String?
  addedBy             User?   @relation("VaultEntryAddedBy", fields: [addedByUserId], references: [id])
  importedFromShareId String?
  provenanceChain     Json? // append-only [{ userId, nickname, addedAt }, …]

  // Plot identity
  emirate        String
  district       String
  plotNumber     String
  publicParcelId String?
  publicParcel   Parcel? @relation("VaultEntryPublicParcel", fields: [publicParcelId], references: [id])

  // Plot facts (denormalised). For DDA hits, populated from the existing
  // DDA scrape on first upload. For non-DDA: user enters manually
  // (area, optional lat/lng). MVP renders a flat marker on map if no
  // geometry. Phase 2.2 ships Affection Plan PDF parsing for non-DDA.
  area      Float?
  latitude  Float?
  longitude Float?
  geometry  Json?
  landUse   String?

  // Broker's data
  askingPriceFils BigInt?
  ownerContact    Json? // { name, phone, email, role, notes } — PII
  brokerNotes     String?    @db.Text
  stage           VaultStage @default(LEAD)
  source          String? // "cold-call" | "referral" | "dda-scrape" | "off-plan" | …
  nextFollowUpAt  DateTime?

  // Promote-to-Public bookkeeping. The actual promote routes through
  // the existing /api/parcels/submit flow (which carries its own
  // verification gates). promotedAt + promotedParcelId are set on
  // successful promote completion.
  promotedAt       DateTime?
  promotedParcelId String?

  // Conflict detection (info-only banner). Set true when ≥ 2 VaultEntry
  // rows exist for the same (emirate, district, plotNumber) tuple
  // across different users AND any conflict-relevant field disagrees
  // beyond tolerances. Maintained by src/lib/vault-conflict.ts on
  // entry create / update / delete.
  conflictsWithOthers Boolean @default(false)
  conflictedFields    Json? // [{ field, values: [{ userId, value }] }]

  // Snapshot of the DDA response when the entry was created via Path 1
  // (live DDA lookup, plot not in our curated Parcel index). Stores the
  // raw BASIC_LAND_BASE feature so the map renderer can apply ZAAHI
  // Signature tiers without joining to AffectionPlan. Null for entries
  // that resolved via publicParcelId (existing curated parcels) or via
  // manual entry. See src/app/api/me/vault/plot-lookup/route.ts.
  ddaSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shares       VaultShare[]
  activity     VaultActivity[]
  priceHistory VaultPriceHistory[]

  @@unique([ownerId, emirate, district, plotNumber])
  @@index([ownerId])
  @@index([stage])
  @@index([publicParcelId])
  @@index([nextFollowUpAt])
  @@index([emirate, district, plotNumber]) // drives conflict detection
}

// Per-recipient access grant on a single VaultEntry. MVP grants VIEW
// only; permission enum has FEASIBILITY and OFFER declared so Phase 2.2
// can ship gate behaviour without an enum migration.
model VaultShare {
  id              String     @id @default(cuid())
  vaultEntryId    String
  vaultEntry      VaultEntry @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)
  ownerId         String // denormalised from vaultEntry.ownerId
  recipientUserId String
  recipient       User       @relation("VaultShareRecipient", fields: [recipientUserId], references: [id])

  permission    VaultSharePermission @default(VIEW)
  expiresAt     DateTime? // NULL = never
  revokedAt     DateTime?
  revokedReason String?

  createdAt    DateTime  @default(now())
  lastViewedAt DateTime? // updated on every GET by recipient

  @@unique([vaultEntryId, recipientUserId])
  @@index([recipientUserId, revokedAt])
  @@index([ownerId])
}

// Append-only activity log per VaultEntry. Drives the side-panel
// activity feed and contributes to the per-user ActivityLog via a
// companion `logActivity()` call (shadow-row pattern — every
// VaultActivity write pairs with a user-centric ActivityLog row).
//
// `kind` is UPPER_SNAKE_CASE per src/lib/activity.ts convention.
// Closed enum lives in src/lib/vault-activity.ts. Payload capped at
// 4 KB at write time.
model VaultActivity {
  id           String     @id @default(cuid())
  vaultEntryId String
  vaultEntry   VaultEntry @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)
  actorUserId  String? // NULL for system events
  actor        User?      @relation("VaultActivityActor", fields: [actorUserId], references: [id])
  kind         String
  payload      Json?
  createdAt    DateTime   @default(now())

  @@index([vaultEntryId, createdAt])
}

// Append-only price history. One row per change (including the initial
// set). Drives the "Price history (N changes)" expandable section in
// the side panel.
model VaultPriceHistory {
  id           String     @id @default(cuid())
  vaultEntryId String
  vaultEntry   VaultEntry @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)
  priceFils    BigInt
  setByUserId  String
  source       String // "manual" | "import" | "promote-sync"
  note         String?
  createdAt    DateTime   @default(now())

  @@index([vaultEntryId, createdAt])
}

// Feedback throttle state, shared across serverless instances.
//
// Added 2026-09-04 on explicit founder instruction (docs/BACKLOG.md §8).
// CLAUDE.md forbids touching schema.prisma without that instruction; this is
// a new table only — no existing model is altered.
//
// Why it exists: /api/archie/feedback kept its rate limit, its 24h text dedup
// and its per-message idempotency key in module-scope Maps. On Vercel those
// reset on every cold start and are not shared between concurrent lambdas, so
// none of the three guards actually held. The 429s the founder hit during QA
// were instance affinity, not policy.
//
// One row per ACCEPTED submission. Deleted again if delivery fails, so a note
// that reached nobody consumes neither quota nor a dedup slot.
model FeedbackSubmission {
  id           String   @id @default(cuid())
  userId       String
  // Idempotency key, one per user MESSAGE (not per tool call). Nullable so an
  // older client without the key is still accepted; Postgres allows many NULLs
  // under a unique constraint, which is exactly the behaviour wanted here.
  submissionId String?
  // SHA-256 of the normalised feedback text. Hashed rather than stored raw:
  // this table is throttle state, not a copy of user content.
  textHash     String
  createdAt    DateTime @default(now())

  // Collapse a repeat of the same conversational turn atomically — the insert
  // races cleanly instead of a check-then-insert that two lambdas can both win.
  @@unique([userId, submissionId])
  // Rate-limit counting and TTL cleanup.
  @@index([userId, createdAt])
  // 24h text dedup.
  @@index([userId, textHash, createdAt])
  @@index([createdAt])
}
